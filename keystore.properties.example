# Copy this file to keystore.properties (which is gitignored) and fill in your
# own values. Then `./gradlew :app:assembleRelease` produces a signed
# app/build/outputs/apk/release/app-release.apk.
#
# Keep the .jks file and these passwords out of git. Losing them means you
# cannot update an installed release build in place.
storeFile=/absolute/path/to/your-release.jks
storePassword=change-me
keyAlias=change-me
keyPassword=change-me
