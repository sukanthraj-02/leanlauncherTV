<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        state_focused is what the D-pad sets, so it must be checked first. Without this
        branch a focused tab renders identically to an idle one and the user cannot tell
        which control the remote is on.
    -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#40FFFFFF" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/focus_accent" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item
                android:gravity="bottom"
                android:height="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/focus_accent" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1FFFFFFF" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item
                android:gravity="bottom"
                android:height="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/focus_accent" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>